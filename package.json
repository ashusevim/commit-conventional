{
    "name": "commit-conventional",
    "version": "1.1.0",
    "description": "An interactive CLI for creating Conventional Commits with Git.",
    "type": "commonjs",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "bin": {
        "commit-conventional": "dist/index.js"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsc --pretty",
        "clean": "tsc --build --clean",
        "prepack": "npm run build",
        "prepublishOnly": "npm test",
        "start": "node dist/index.js",
        "test": "npm run build && node --test"
    },
    "keywords": [
        "git",
        "commit",
        "conventional-commits",
        "cli"
    ],
    "author": "wanony",
    "license": "ISC",
    "engines": {
        "node": ">=18"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/codingashishdev/conventional-committer.git"
    },
    "bugs": {
        "url": "https://github.com/codingashishdev/conventional-committer/issues"
    },
    "homepage": "https://github.com/codingashishdev/conventional-committer#readme",
    "devDependencies": {
        "@types/node": "^24.3.0",
        "typescript": "^5.9.2"
    },
    "dependencies": {
        "inquirer": "^12.9.3"
    }
}
